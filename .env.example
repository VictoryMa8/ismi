# Copy to .env or .env.local for local-only overrides.
# These files are ignored by Git.
# The root npm run api and npm run web commands load both files.

# Local launcher ports (the frontend API proxy follows ISMI_API_PORT).
# ISMI_API_PORT=5062
# ISMI_WEB_PORT=5173

# Enable the curriculum console for one owner account (ASP.NET config key).
# Curriculum__ApproverEmail=you@example.com

# Optional Google sign-in and Resend email codes. Server-side configuration only.
# Set up providers before enabling; see docs/account-sign-in.md.
# Authentication__Google__ClientId=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# LoginEmail__ResendApiKey=YOUR_SENDING_ONLY_RESEND_KEY
# LoginEmail__From="Ismi <signin@vexillologists.com>"
# LoginEmail__DailyLimit=50

# Point a separately started Vite dev/preview proxy at an API (optional).
# The root launcher instead uses ISMI_API_PORT above.
# ISMI_API_PROXY_TARGET=http://127.0.0.1:5062

# Vercel frontend deployment: separately hosted HTTPS ASP.NET API origin.
# Required in the deployment environment, not bundled as a VITE_ client variable.
# ISMI_API_ORIGIN=https://your-api-host.example
