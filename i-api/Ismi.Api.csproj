<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- dotnet watch reads this path directly; forward slashes also work on Windows. -->
    <IntermediateOutputPath>obj/$(Configuration)/</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../content/levantine/expansion-20/*-lesson.json" LogicalName="Ismi.LevantineExpansion.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../content/levantine/expansion-20/review-manifest.json" LogicalName="Ismi.LevantineExpansion.review-manifest.json" />
    <EmbeddedResource Include="../content/stories/after-a-long-day/01.pack.json" LogicalName="Ismi.StoryPreview.01.pack.json" />
    <EmbeddedResource Include="../content/stories/after-a-long-day/revisions/current-source/01.pack.json" LogicalName="Ismi.StoryArcPreview.01.pack.json" />
    <EmbeddedResource Include="../content/stories/after-a-long-day/02.pack.json" LogicalName="Ismi.StoryArcPreview.02.pack.json" />
    <EmbeddedResource Include="../content/stories/after-a-long-day/03.pack.json" LogicalName="Ismi.StoryArcPreview.03.pack.json" />
    <EmbeddedResource Include="../content/alphabet/inventory-preview/*.pack.json" LogicalName="Ismi.AlphabetPreview.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../content/alphabet/sources/UNICODE-LICENSE-V3.txt" LogicalName="Ismi.AlphabetPreview.UnicodeLicense.txt" />
    <EmbeddedResource Include="../content/french/meet-01/*-lesson.json" LogicalName="Ismi.FrenchPreview.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../content/khmer/meet-01/*-lesson.json" LogicalName="Ismi.KhmerPreview.%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.10.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

</Project>
