{
  "framework": "vite",
  "installCommand": "npm --prefix i-web ci",
  "buildCommand": "npm --prefix i-web run build",
  "outputDirectory": "i-web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ismi.alwaysdata.net/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}